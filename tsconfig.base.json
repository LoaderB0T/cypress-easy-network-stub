{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2025"
    ],
    "declaration": true,
    "outDir": "lib",
    "rootDir": ".",
    "strict": true,
    "types": [
      "node",
      "cypress"
    ],
    "sourceMap": true,
    "esModuleInterop": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "newLine": "lf"
  },
  "exclude": [
    "lib",
    "test"
  ]
}
